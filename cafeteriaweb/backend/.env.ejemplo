# Ejemplo del archivo .env. NO se edita a mano: preparar.ps1 genera el .env real
# con valores aleatorios (y lo deja fuera de Git). Aqui solo van referencias.
VAULT_ROOT_TOKEN=<generado por preparar.ps1>
MONGO_ROOT_PASSWORD=<generado por preparar.ps1>
PROVEEDOR_API_KEY=<generado por preparar.ps1>
PROVEEDOR_CLAVE_FIRMA=<generado por preparar.ps1>
GATEWAY_VAULT_TOKEN=<token de Vault con la politica gateway>
AUTH_VAULT_TOKEN=<token de Vault con la politica auth>
INVENTORY_VAULT_TOKEN=<token de Vault con la politica inventory>
CLIENTS_VAULT_TOKEN=<token de Vault con la politica clients>
MENSAJERIA_VAULT_TOKEN=<token de Vault con la politica mensajeria>
ORDERS_VAULT_TOKEN=<token de Vault con la politica orders>
PAYMENTS_VAULT_TOKEN=<token de Vault con la politica payments>
DESPACHO_VAULT_TOKEN=<token de Vault con la politica despacho>
GRAPHQL_VAULT_TOKEN=<token de Vault con la politica graphql>
# Opcional, solo para la prueba de carga (por defecto 120 y 10)
# LIMITE_POR_MINUTO=120
# LIMITE_LOGIN_POR_MINUTO=10
